# StudyMate AI — Environment Variables Example
# Copy this file to .env.local and fill in your Firebase Web App values.
# Never commit .env.local or production secrets to version control.
# Note: When running inside AI Studio with firebase-applet-config.json present,
# StudyMate AI automatically reads public Firebase config from that file if VITE_FIREBASE_* vars are omitted.

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Firebase App Check (recommended for production)
# Create a reCAPTCHA Enterprise site key in Google Cloud and register it in Firebase Console -> App Check.
VITE_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=""
# Optional: For local development only, set to "true" to enable the Firebase App Check debug token generator
# (prints a one-time debug token to your browser console; never commit an actual production debug token).
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=""

# Firebase AI Logic cloud fallback model
VITE_CLOUD_GEMINI_MODEL="gemini-2.5-flash"

# Development-only simulated demo mode (kept disabled in production builds)
VITE_ENABLE_DEMO_MODE="false"

# Optional AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
